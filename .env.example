# Cloud DevBox runtime configuration. Set these as PaaS environment variables /
# secrets. Never commit a real .env file.

# --- Browser IDE login (required: one of the two) ---------------------------
PASSWORD=replace-with-a-long-random-password
# HASHED_PASSWORD=$argon2i$v=19$m=4096,t=3,p=1$...   # preferred; see README

# --- S3-compatible backup (optional, strongly recommended) ------------------
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=devbox-backups
S3_PREFIX=cloud-devbox
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true          # default true; set false for virtual-hosted buckets
# Encrypts snapshots client-side and enables backing up gh/tunnel/ssh credentials.
BACKUP_PASSPHRASE=replace-with-a-second-long-random-secret

# --- Backup behaviour (optional) --------------------------------------------
# DEVBOX_BACKUP_INTERVAL=900        # seconds between automatic backups; 0 disables
# DEVBOX_BACKUP_KEEP=48             # snapshots kept in S3
# DEVBOX_BACKUP_EXCLUDES="storage/logs dist"   # extra names to skip
# DEVBOX_AUTO_RESTORE=true          # restore latest snapshot into an empty workspace on boot

# --- Services (optional) ----------------------------------------------------
# DEVBOX_REDIS=true                 # local Redis on 127.0.0.1:6379 for Laravel queue/cache
# TUNNEL_NAME=cloud-devbox          # VS Code Remote Tunnel machine name
# PROXY_DOMAIN=dev.example.com      # code-server port proxy on {{port}}.dev.example.com (wildcard DNS+TLS)
# PORT=8080                         # HTTP port, if the platform injects a different one
